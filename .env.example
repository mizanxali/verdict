ANTHROPIC_API_KEY=
# FAKE_LLM=1 runs the whole game on a deterministic stub, no API calls
# Deepgram voice: characters speak their lines (Aura text-to-speech) and the player can dictate
# questions and speeches (Nova-3 speech-to-text). Leave empty for a silent, text-only game.
DEEPGRAM_API_KEY=
# Optional: another Deepgram host (e.g. https://api.eu.deepgram.com), and VOICE_LOG=1 to log one
# line per Deepgram call (voice, size, timing; never the text or the key).
# DEEPGRAM_API_URL=
# VOICE_LOG=1
